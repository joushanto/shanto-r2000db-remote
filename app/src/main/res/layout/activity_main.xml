<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#101923" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#85DCD2" android:textSize="14sp" android:layout_marginTop="16dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:layout_marginTop="8dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/model" android:textColor="#A8B8C8" android:textSize="15sp" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/power" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/power" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /><com.google.android.material.button.MaterialButton android:id="@+id/mute" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/mute" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/volume_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/volume_down" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /><com.google.android.material.button.MaterialButton android:id="@+id/volume_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/volume_up" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="6dp" android:paddingStart="8dp" android:text="@string/inputs" android:textColor="#96BDCE" android:textSize="12sp" android:letterSpacing="0.15" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/line1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/line1" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /><com.google.android.material.button.MaterialButton android:id="@+id/line2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/line2" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/opt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/opt" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /><com.google.android.material.button.MaterialButton android:id="@+id/bluetooth" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/bluetooth" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="6dp" android:paddingStart="8dp" android:text="@string/equalizer" android:textColor="#96BDCE" android:textSize="12sp" android:letterSpacing="0.15" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/eq_classic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/eq_classic" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /><com.google.android.material.button.MaterialButton android:id="@+id/eq_dynamic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:layout_margin="4dp" android:text="@string/eq_dynamic" android:textSize="17sp" android:textAllCaps="false" android:backgroundTint="#243546" android:textColor="#FFFFFF" app:cornerRadius="18dp" /></LinearLayout>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ready" android:textColor="#85DCD2" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feedback" android:textColor="#A8B8C8" android:textSize="12sp" />
</LinearLayout></ScrollView>
